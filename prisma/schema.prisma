generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              Role              @default(TEACHER)
  createdAt         DateTime          @default(now())
  submittedRequests ApprovalRequest[] @relation("Requester")
  actionedSteps     ApprovalStep[]    @relation("Actioner")
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  title         String
  category      Category
  description   String         @db.Text
  priority      Priority       @default(MEDIUM)
  status        RequestStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  submittedById String
  submittedBy   User           @relation("Requester", fields: [submittedById], references: [id])
  steps         ApprovalStep[]

  @@index([submittedById])
  @@index([status])
  @@index([category])
}

model ApprovalStep {
  id           String          @id @default(cuid())
  stepOrder    Int
  approverRole Role
  status       StepStatus      @default(PENDING)
  comment      String?         @db.Text
  actionedAt   DateTime?
  createdAt    DateTime        @default(now())
  requestId    String
  actionedById String?
  actionedBy   User?           @relation("Actioner", fields: [actionedById], references: [id])
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepOrder])
  @@index([requestId])
  @@index([actionedById], map: "ApprovalStep_actionedById_fkey")
}

enum Role {
  TEACHER
  HOD
  PRINCIPAL
  ADMIN
}

enum Category {
  LEAVE
  BUDGET
  INFRASTRUCTURE
  ACADEMIC
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
}
